# Yomi Reader configuration (copy to .env or export in your shell)

# Where the SQLite DB, session key and cover cache live.
DATA_PATH=./data
PORT=8098

# plex (plex.tv PIN, default) | local (username/password) | mock (dev auto-login)
AUTH_PROVIDER=plex

# Set true only when served over HTTPS (browsers drop Secure cookies on http://).
COOKIE_SECURE=false

# Optional. When empty a random key is generated and stored in DATA_PATH/session.key.
SESSION_SECRET=

# --- plex provider (default) ---
# Required. Plex Media Server machineIdentifier (Settings → General, or /identity).
PLEX_MACHINE_ID=
# Optional. Used for the server-side /auth/login redirect callback. Popup login
# does not need it. Example: https://yomi.example.com
PUBLIC_BASE_URL=

# --- local provider (AUTH_PROVIDER=local) ---
# Created on an empty DB (or when this user does not exist yet).
# Without these, admin/admin is created on an empty database.
ADMIN_USER=
ADMIN_PASS=

# --- mock provider (AUTH_PROVIDER=mock) ---
MOCK_USER=dev
MOCK_ADMIN=true

# Cover thumbnail width in pixels (height = width * 1.5).
THUMB_WIDTH=300

# Library auto-registered on first run (read-only access is enough).
# If empty and M:\books\suwayomi exists, that folder is used.
# Layout: <root>/mangas/{Source}/{Series}/{Chapter.cbz | chapter folder}
DEFAULT_LIBRARY_PATH=

# Filesystem watcher for auto-rescans (periodic interval is set in admin settings).
AUTOSCAN_WATCH=true

# Directory with the SPA (index.html ...).
STATIC_DIR=static
